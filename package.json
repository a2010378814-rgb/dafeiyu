{
  "name": "claude-desktop-pet",
  "version": "0.2.0",
  "description": "Windows 桌宠：Claude 鲸鱼娘（2D 网格变形动画）",
  "license": "MIT",
  "type": "module",
  "main": "electron/main.cjs",
  "scripts": {
    "start": "node launcher/index.mjs",
